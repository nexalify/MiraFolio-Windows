<Application x:Class="MiraFolio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Localization/Strings.en.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Core palette — deep space dark + purple/pink accent -->
      <SolidColorBrush x:Key="PrimaryBrush"    Color="#7C3AED"/>
      <SolidColorBrush x:Key="AccentBrush"     Color="#7C3AED"/>
      <SolidColorBrush x:Key="AccentPinkBrush" Color="#EC4899"/>
      <SolidColorBrush x:Key="BackgroundBrush" Color="#07070F"/>
      <SolidColorBrush x:Key="SurfaceBrush"    Color="#0F0F24"/>
      <SolidColorBrush x:Key="TextBrush"       Color="#EEEDF8"/>
      <SolidColorBrush x:Key="SubtextBrush"    Color="#7A7A98"/>

      <!-- Gradient brushes -->
      <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#EC4899" Offset="1"/>
      </LinearGradientBrush>

      <LinearGradientBrush x:Key="BgGradientBrush" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#07070F" Offset="0"/>
        <GradientStop Color="#0A0720" Offset="1"/>
      </LinearGradientBrush>
    </ResourceDictionary>
  </Application.Resources>
</Application>
