<Window x:Class="MiraFolio.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MiraFolio.App.Converters"
        mc:Ignorable="d"
        Title="MiraFolio"
        Icon="pack://application:,,,/Resources/mirafolio-icon.ico"
        Height="820" Width="1000"
        MinHeight="820" MinWidth="920"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None">

  <!-- Remove native title bar while keeping resize/snap via WindowChrome -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="62"
                  ResizeBorderThickness="5"
                  CornerRadius="0"
                  GlassFrameThickness="0"/>
  </WindowChrome.WindowChrome>

  <Window.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
      <GradientStop Color="#07070F" Offset="0"/>
      <GradientStop Color="#0A0720" Offset="1"/>
    </LinearGradientBrush>
  </Window.Background>

  <Window.Resources>
    <converters:ThumbnailConverter x:Key="ThumbnailConverter" DecodePixelWidth="300"/>

    <!-- ── Local gradient brushes ── -->
    <LinearGradientBrush x:Key="AccentGradientH" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#7C3AED" Offset="0"/>
      <GradientStop Color="#EC4899" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientV" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#7C3AED" Offset="0"/>
      <GradientStop Color="#EC4899" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientVRev" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#EC4899" Offset="0"/>
      <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── Window control buttons (caption area) ── -->
    <Style x:Key="WinControlButtonStyle" TargetType="Button">
      <Setter Property="Width"          Value="46"/>
      <Setter Property="Background"     Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground"     Value="#8080A8"/>
      <Setter Property="Cursor"         Value="Arrow"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WinCloseButtonStyle" TargetType="Button">
      <Setter Property="Width"          Value="46"/>
      <Setter Property="Background"     Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground"     Value="#8080A8"/>
      <Setter Property="Cursor"         Value="Arrow"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#A32318"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── Card ── -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background"       Value="#0F0F24"/>
      <Setter Property="BorderBrush"      Value="#1E1E42"/>
      <Setter Property="BorderThickness"  Value="1"/>
      <Setter Property="CornerRadius"     Value="12"/>
      <Setter Property="Padding"          Value="20"/>
      <Setter Property="Margin"           Value="0,0,0,12"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6"
                            Opacity="0.45" Direction="270"/>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── Typography ── -->
    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#7A7A98"/>
      <Setter Property="FontSize"   Value="11"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Margin"     Value="0,0,0,5"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="Foreground"        Value="#C8C6E0"/>
      <Setter Property="FontSize"          Value="12"/>
      <Setter Property="FontWeight"        Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── TextBox ── -->
    <Style x:Key="InputStyle" TargetType="TextBox">
      <Setter Property="Background"      Value="#090918"/>
      <Setter Property="Foreground"      Value="#F0EEF8"/>
      <Setter Property="BorderBrush"     Value="#252548"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="10,5"/>
      <Setter Property="Height"          Value="38"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="CaretBrush"      Value="#7C3AED"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#3A3A70"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#7C3AED"/>
                <Setter TargetName="InputBorder" Property="Background"  Value="#0C0C20"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── Primary Button — purple gradient ── -->
    <Style x:Key="ButtonStyle" TargetType="Button">
      <Setter Property="Foreground"      Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"         Value="16,8"/>
      <Setter Property="Height"          Value="36"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="FontWeight"      Value="Medium"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#7C3AED" Offset="0"/>
                  <GradientStop Color="#9B59F5" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.72"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.38"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── Secondary Button — ghost/outline ── -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground"      Value="#C0BEDA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="12,0"/>
      <Setter Property="Height"          Value="38"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="#14142A"
                    BorderBrush="#2E2E58"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="BorderBrush" Value="#7C3AED"/>
                <Setter TargetName="Bg" Property="Background"  Value="#1A1A3A"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Opacity" Value="0.38"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── CheckBox — modern gradient fill ── -->
    <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D0CEEA"/>
      <Setter Property="Margin"     Value="0,6"/>
      <Setter Property="FontSize"   Value="13"/>
      <Setter Property="Cursor"     Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <BulletDecorator Background="Transparent">
              <BulletDecorator.Bullet>
                <Border x:Name="CheckBorder"
                        Width="18" Height="18"
                        Margin="0,1,10,0"
                        Background="#0D0D22"
                        BorderBrush="#2E2E58"
                        BorderThickness="1.5"
                        CornerRadius="4">
                  <Path x:Name="CheckMark"
                        Width="10" Height="7"
                        Data="M 0 4 L 3 7 L 10 0"
                        Stroke="White"
                        StrokeThickness="2"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>
              </BulletDecorator.Bullet>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </BulletDecorator>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#7C3AED"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckBorder" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#7C3AED" Offset="0"/>
                      <GradientStop Color="#9B59F5" Offset="1"/>
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#7C3AED"/>
                <Setter TargetName="CheckMark"   Property="Visibility"  Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── ComboBox Item ── -->
    <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
      <Setter Property="Foreground"                 Value="#D8D6F0"/>
      <Setter Property="Background"                 Value="#0F0F24"/>
      <Setter Property="Padding"                    Value="10,8"/>
      <Setter Property="FontSize"                   Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#1E1E48"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background">
            <Setter.Value>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#7C3AED" Offset="0"/>
                <GradientStop Color="#8B47F0" Offset="1"/>
              </LinearGradientBrush>
            </Setter.Value>
          </Setter>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ── ComboBox Toggle Button ── -->
    <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
      <Setter Property="Focusable"       Value="False"/>
      <Setter Property="Background"      Value="#090918"/>
      <Setter Property="BorderBrush"     Value="#252548"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="ToggleBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1"
                        BorderBrush="#252548" BorderThickness="1,0,0,0"
                        Background="Transparent">
                  <Path Width="8" Height="5"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M 0 0 L 4 5 L 8 0"
                        Fill="#7A7A98" Stretch="Fill"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#3A3A70"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#7C3AED"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── ComboBox ── -->
    <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Foreground"      Value="#D8D6F0"/>
      <Setter Property="Background"      Value="#090918"/>
      <Setter Property="BorderBrush"     Value="#252548"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height"          Value="38"/>
      <Setter Property="Padding"         Value="10,0"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Name="ToggleButton"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{StaticResource ComboBoxToggleButtonStyle}"/>
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
              <Popup Name="Popup"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     PopupAnimation="Slide">
                <Border Margin="0,4,0,0"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="#0F0F24"
                        BorderBrush="#252548"
                        BorderThickness="1"
                        CornerRadius="6">
                  <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4"
                                      Opacity="0.55" Direction="270"/>
                  </Border.Effect>
                  <ScrollViewer SnapsToDevicePixels="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Popup" Property="MinHeight" Value="38"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#3A3A70"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="#7C3AED"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── Monitor tile hover action button ── -->
    <Style x:Key="TileButtonStyle" TargetType="Button">
      <Setter Property="Foreground"      Value="White"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding"         Value="10,6"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="FontWeight"      Value="Medium"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="#99000000"
                    BorderBrush="#AA7C3AED"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#CC7C3AED" Offset="0"/>
                      <GradientStop Color="#CCEC4899" Offset="1"/>
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
                <Setter TargetName="Bg" Property="BorderBrush" Value="Transparent"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TileIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TileButtonStyle}">
      <Setter Property="Width"   Value="40"/>
      <Setter Property="Height"  Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin"  Value="5,0"/>
    </Style>

    <!-- ── Monitor tile — with selection glow ── -->
    <Style x:Key="MonitorTileStyle" TargetType="Border">
      <Setter Property="Background"      Value="#0C0C1E"/>
      <Setter Property="BorderBrush"     Value="#1E1E42"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius"    Value="8"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="ClipToBounds"    Value="True"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="BorderBrush"     Value="#7C3AED"/>
          <Setter Property="BorderThickness" Value="2"/>
          <Setter Property="Effect">
            <Setter.Value>
              <DropShadowEffect Color="#7C3AED" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/>
            </Setter.Value>
          </Setter>
        </DataTrigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#9B59F5"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>  <!-- App header bar (custom title bar) -->
      <RowDefinition Height="2"/>     <!-- Gradient divider line -->
      <RowDefinition Height="*"/>     <!-- Main content -->
    </Grid.RowDefinitions>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Custom Title Bar / App Header                           -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Border Grid.Row="0" Background="#0C0C20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>    <!-- Logo + title -->
          <ColumnDefinition Width="Auto"/> <!-- Settings actions -->
          <ColumnDefinition Width="Auto"/> <!-- Min / Max / Close buttons -->
        </Grid.ColumnDefinitions>

        <!-- Left: logo + title -->
        <Grid Grid.Column="0" Margin="24,14">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0"
                    ClipToBounds="True">
              <Image Source="pack://application:,,,/Resources/app-icon.png"
                     Stretch="UniformToFill"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Text="MiraFolio"
                       FontSize="16" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Height="32"
                  Margin="0,0,8,0"
                  Padding="12,0"
                  VerticalAlignment="Center"
                  Style="{StaticResource SecondaryButtonStyle}"
                  ToolTip="{DynamicResource LanguageSettingsTooltip}"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="LanguageSettingsButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⚙" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource SettingsButton}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button
                Height="32"
                Margin="0,0,12,0"
                Padding="12,0"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryButtonStyle}"
                ToolTip="{DynamicResource RecycleBinTooltip}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="RecycleBinButton_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource RecycleBin}" VerticalAlignment="Center"/>
            <Border MinWidth="18" Height="18" Padding="4,0" Margin="7,0,0,0"
                    CornerRadius="9" Background="#EC4899">
              <TextBlock Text="{Binding RemovedImageCount}"
                         Foreground="White"
                         FontSize="10"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          </Button>
        </StackPanel>

        <!-- Right: window control buttons (full header height, no padding) -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">

          <!-- Minimize -->
          <Button Style="{StaticResource WinControlButtonStyle}"
                  Click="MinimizeButton_Click" ToolTip="{DynamicResource Minimize}">
            <Viewbox Width="11" Height="2" SnapsToDevicePixels="True">
              <Canvas Width="11" Height="2">
                <Line X1="0" Y1="1" X2="11" Y2="1"
                      Stroke="#9090B8" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Canvas>
            </Viewbox>
          </Button>

          <!-- Maximize / Restore -->
          <Button Style="{StaticResource WinControlButtonStyle}"
                  Click="MaximizeRestoreButton_Click" ToolTip="{DynamicResource Maximize}">
            <Viewbox Width="11" Height="11" SnapsToDevicePixels="True">
              <Canvas Width="11" Height="11">
                <Rectangle Canvas.Left="0.9" Canvas.Top="0.9"
                            Width="9.2" Height="9.2"
                            RadiusX="1" RadiusY="1"
                            Fill="Transparent"
                            Stroke="#9090B8" StrokeThickness="1.6"/>
              </Canvas>
            </Viewbox>
          </Button>

          <!-- Close -->
          <Button Style="{StaticResource WinCloseButtonStyle}"
                  Click="CloseButton_Click" ToolTip="{DynamicResource Close}">
            <Viewbox Width="11" Height="11" SnapsToDevicePixels="True">
              <Canvas Width="11" Height="11">
                <Line X1="0.5" Y1="0.5" X2="10.5" Y2="10.5"
                      Stroke="#9090B8" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line X1="10.5" Y1="0.5" X2="0.5" Y2="10.5"
                      Stroke="#9090B8" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Canvas>
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Gradient divider -->
    <Rectangle Grid.Row="1">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#00000000" Offset="0"/>
          <GradientStop Color="#7C3AED"   Offset="0.3"/>
          <GradientStop Color="#EC4899"   Offset="0.7"/>
          <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Main content area                                       -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Grid Grid.Row="2" Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ── Monitor Layout Visualization ── -->
      <Border Grid.Row="0" Style="{StaticResource CardStyle}">
        <StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Monitors}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas Width="{Binding DataContext.MonitorCanvasWidth,  RelativeSource={RelativeSource AncestorType=Window}}"
                          Height="{Binding DataContext.MonitorCanvasHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                  <Setter Property="Canvas.Left" Value="{Binding ScaledLeft}"/>
                  <Setter Property="Canvas.Top"  Value="{Binding ScaledTop}"/>
                </Style>
              </ItemsControl.ItemContainerStyle>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource MonitorTileStyle}"
                          Width="{Binding ScaledWidth}" Height="{Binding ScaledHeight}"
                          ToolTip="{Binding FriendlyName}">
                    <Border.InputBindings>
                      <MouseBinding MouseAction="LeftClick"
                                    Command="{Binding DataContext.SelectMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                    </Border.InputBindings>
                    <Border.Triggers>
                      <EventTrigger RoutedEvent="Border.MouseEnter">
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                      <EventTrigger RoutedEvent="Border.MouseLeave">
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.1"/>
                          </Storyboard>
                        </BeginStoryboard>
                      </EventTrigger>
                    </Border.Triggers>

                    <Grid>
                      <Image Source="{Binding CurrentWallpaperPath, Converter={StaticResource ThumbnailConverter}}"
                             Stretch="UniformToFill" Opacity="0.65"
                             IsHitTestVisible="False"
                             RenderOptions.BitmapScalingMode="HighQuality"/>

                      <Border VerticalAlignment="Top" HorizontalAlignment="Center"
                              Margin="0,6,0,0"
                              Background="#CC000000" CornerRadius="4" Padding="7,3"
                              IsHitTestVisible="False">
                        <TextBlock Text="{Binding CurrentWallpaperDimensionsText}"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="#E0DEFC" TextAlignment="Center"/>
                      </Border>

                      <Border VerticalAlignment="Bottom" CornerRadius="0,0,8,8"
                              IsHitTestVisible="False">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#CC000000" Offset="1"/>
                          </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding DisplayLabel}"
                                   FontSize="10" FontWeight="SemiBold"
                                   TextAlignment="Center" Foreground="White"
                                   TextWrapping="Wrap" Margin="4,4,4,5"/>
                      </Border>

                      <Grid x:Name="HoverOverlay" Opacity="0">
                        <Border CornerRadius="8" IsHitTestVisible="False">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                              <GradientStop Color="#BB07051A" Offset="0"/>
                              <GradientStop Color="#CC120A28" Offset="1"/>
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>
                        <WrapPanel HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="8">
                          <Button Style="{StaticResource TileIconButtonStyle}"
                                  ToolTip="{DynamicResource RotateNow}"
                                  Command="{Binding DataContext.RotateNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}">
                            <Viewbox Width="18" Height="18">
                              <Canvas Width="24" Height="24">
                                <Path Data="M12,4 A8,8 0 1 1 4,12"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M4,7 L4,12 L9,12"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                              </Canvas>
                            </Viewbox>
                          </Button>
                          <Button Style="{StaticResource TileIconButtonStyle}"
                                  ToolTip="{DynamicResource OpenImageLocation}"
                                  Command="{Binding DataContext.OpenCurrentImageLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}">
                            <Viewbox Width="18" Height="18">
                              <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="3" Canvas.Top="4"
                                           Width="18" Height="16"
                                           RadiusX="2" RadiusY="2"
                                           Fill="Transparent"
                                           Stroke="White" StrokeThickness="1.7"/>
                                <Ellipse Canvas.Left="7" Canvas.Top="7"
                                         Width="3" Height="3"
                                         Fill="White"/>
                                <Path Data="M5,17 L10,12 L13,15 L16,12 L20,17"
                                      Stroke="White" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                              </Canvas>
                            </Viewbox>
                          </Button>
                          <Button Style="{StaticResource TileIconButtonStyle}"
                                  ToolTip="{DynamicResource RemoveCurrentImage}"
                                  Command="{Binding DataContext.RemoveCurrentImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}">
                            <Viewbox Width="18" Height="18">
                              <Canvas Width="24" Height="24">
                                <Path Data="M5,7 L19,7 M9,7 L9,5 L15,5 L15,7 M7,7 L8,20 L16,20 L17,7 M10,10 L10.5,17 M14,10 L13.5,17"
                                      Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                              </Canvas>
                            </Viewbox>
                          </Button>
                        </WrapPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- ── Settings Row ── -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Per-Monitor Settings -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
          <StackPanel DataContext="{Binding SelectedMonitor}">
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" CornerRadius="2" Margin="0,2,0,2"
                      Background="{StaticResource AccentGradientV}"/>
              <TextBlock Grid.Column="1" Text="{DynamicResource MonitorConfiguration}"
                         Style="{StaticResource SectionHeaderStyle}"
                         Margin="10,0,18,0"/>
              <TextBlock Grid.Column="2"
                         Text="{Binding FriendlyName}"
                         ToolTip="{Binding FriendlyName}"
                         Foreground="#A78BFA"
                         FontSize="13"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         TextAlignment="Right"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>

            <TextBlock Style="{StaticResource LabelStyle}" Text="{DynamicResource WallpaperFolder}"/>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" Style="{StaticResource InputStyle}"
                       Text="{Binding FolderPath}"
                       ToolTip="{Binding FolderPath}"/>
              <Button Grid.Column="2" Content="{DynamicResource Browse}"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding BrowseFolderCommand}" MinWidth="66"/>
            </Grid>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource LabelStyle}" Text="{DynamicResource RotationInterval}"/>
                <TextBox Style="{StaticResource InputStyle}"
                         Text="{Binding IntervalValue}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource LabelStyle}" Text="{DynamicResource Unit}"/>
                <ComboBox Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding DataContext.IntervalUnitOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Label"
                          SelectedValue="{Binding IntervalUnit}"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Style="{StaticResource LabelStyle}" Text="{DynamicResource PlaybackOrder}"/>
                <ComboBox Style="{StaticResource ComboBoxStyle}"
                          ItemsSource="{Binding DataContext.PlaybackOrderOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Label"
                          SelectedValue="{Binding PlaybackOrder}"/>
              </StackPanel>
            </Grid>

            <Rectangle Height="1" Margin="0,2,0,12">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#00000000" Offset="0"/>
                  <GradientStop Color="#252548"   Offset="0.5"/>
                  <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>

            <CheckBox Style="{StaticResource CheckBoxStyle}" IsChecked="{Binding SmartOrientationMatching}">
              <TextBlock Text="{DynamicResource SmartOrientationMatching}"
                         ToolTip="{DynamicResource SmartOrientationMatching}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </CheckBox>
            <CheckBox Style="{StaticResource CheckBoxStyle}" IsChecked="{Binding PauseWhenFullscreen}">
              <TextBlock Text="{DynamicResource PauseWhenFullscreen}"
                         ToolTip="{DynamicResource PauseWhenFullscreen}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </CheckBox>
            <CheckBox Style="{StaticResource CheckBoxStyle}" IsChecked="{Binding Enabled}">
              <TextBlock Text="{DynamicResource EnableMonitorRotation}"
                         ToolTip="{DynamicResource EnableMonitorRotation}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </CheckBox>
          </StackPanel>
        </Border>

        <!-- Global Settings -->
        <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
          <StackPanel DataContext="{Binding GlobalSettings}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <Border Width="3" CornerRadius="2" Margin="0,2,10,2"
                      Background="{StaticResource AccentGradientVRev}"/>
              <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{DynamicResource GlobalSettings}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource LabelStyle}" Text="{DynamicResource WallpaperDisplayMode}"/>
            <ComboBox Margin="0,0,0,16"
                      Style="{StaticResource ComboBoxStyle}"
                      ItemsSource="{Binding DataContext.DisplayModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedValuePath="Value"
                      DisplayMemberPath="Label"
                      SelectedValue="{Binding DisplayMode}"/>

            <Rectangle Height="1" Margin="0,0,0,12">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#00000000" Offset="0"/>
                  <GradientStop Color="#252548"   Offset="0.5"/>
                  <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>

            <CheckBox Style="{StaticResource CheckBoxStyle}" IsChecked="{Binding StartWithWindows}">
              <TextBlock Text="{DynamicResource StartWithWindows}"
                         ToolTip="{DynamicResource StartWithWindows}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </CheckBox>

            <CheckBox Style="{StaticResource CheckBoxStyle}" IsChecked="{Binding DesktopQuickActionsEnabled}">
              <TextBlock Text="{DynamicResource EnableDesktopQuickActions}"
                         ToolTip="{DynamicResource EnableDesktopQuickActions}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </CheckBox>

            <CheckBox Style="{StaticResource CheckBoxStyle}" IsChecked="{Binding LowResolutionFilterEnabled}">
              <TextBlock Text="{DynamicResource EnableLowResolutionFilter}"
                         ToolTip="{DynamicResource EnableLowResolutionFilter}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </CheckBox>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
              <TextBlock Style="{StaticResource LabelStyle}"
                         Text="{DynamicResource MinimumSideThreshold}"
                         Margin="0"
                         VerticalAlignment="Center"/>
              <Border Width="14" Height="14"
                      Margin="5,0,0,0"
                      CornerRadius="7"
                      Background="#251B46"
                      BorderBrush="#6D4BC4"
                      BorderThickness="1"
                      Cursor="Help"
                      ToolTipService.InitialShowDelay="120"
                      ToolTipService.ShowDuration="12000">
                <Border.ToolTip>
                  <ToolTip Placement="Mouse"
                           Background="#17172F"
                           Foreground="#E8E5FA"
                           BorderBrush="#4C3B70"
                           BorderThickness="1"
                           Padding="10,7">
                    <TextBlock Text="{DynamicResource LowResolutionHelp}"
                               FontSize="12" MaxWidth="360" TextWrapping="Wrap"/>
                  </ToolTip>
                </Border.ToolTip>
                <TextBlock Text="!"
                           Foreground="#C4B5FD"
                           FontSize="9"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
            <TextBox Style="{StaticResource InputStyle}"
                     Width="120"
                     HorizontalAlignment="Left"
                     IsEnabled="{Binding LowResolutionFilterEnabled}"
                     Text="{Binding MinimumImageSideLength}"/>
          </StackPanel>
        </Border>
      </Grid>

    </Grid>
  </Grid>
</Window>
