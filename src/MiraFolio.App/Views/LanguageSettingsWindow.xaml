<Window x:Class="MiraFolio.App.Views.LanguageSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LanguageWindowTitle}"
        Icon="pack://application:,,,/Resources/mirafolio-icon.ico"
        Width="520" Height="310" MinWidth="480" MinHeight="290"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0D0D20" Foreground="#F4F1FF"
        FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Width" Value="120"/><Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="18,0"/><Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#6D4BC4"/>
      <Setter Property="BorderBrush" Value="#8B6BE0"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#1B1B38"/><Setter Property="BorderBrush" Value="#414164"/>
    </Style>
    <Style x:Key="LanguageComboBoxItemStyle" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#17172F"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Padding" Value="10,7"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#EDE9FE"/>
          <Setter Property="Foreground" Value="#3B176E"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#DDD6FE"/>
          <Setter Property="Foreground" Value="#3B176E"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="{DynamicResource LanguageHeading}" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="{DynamicResource LanguageDescription}" Margin="0,8,0,22"
               Foreground="#A9A6C5" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="2">
      <TextBlock Text="{DynamicResource LanguageLabel}" Margin="0,0,0,7" Foreground="#C7C4DF"/>
      <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                DisplayMemberPath="NativeName" Height="38" Padding="10,5"
                Background="White" Foreground="#17172F" BorderBrush="#4C3B70"
                ItemContainerStyle="{StaticResource LanguageComboBoxItemStyle}"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Cancel}" Click="Cancel_Click"/>
      <Button Content="{DynamicResource Apply}" IsDefault="True" Click="Apply_Click"/>
    </StackPanel>
  </Grid>
</Window>
