<Window x:Class="MiraFolio.App.DesktopOverlay.DesktopActionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="176"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
  <Window.Resources>
    <Style x:Key="OverlayButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="160"/>
      <Setter Property="Height" Value="160"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BackgroundBorder"
                    Background="#3317172A"
                    BorderBrush="#4D7C3AED"
                    BorderThickness="1"
                    CornerRadius="24">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="#D97C3AED"/>
                <Setter TargetName="BackgroundBorder" Property="BorderBrush" Value="#FFEC4899"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.72"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Keep the full panel-sized surface hit-testable while collapsed so the
       hover target exactly matches the controls that appear. -->
  <Grid Background="#01000000"
        MouseEnter="Overlay_MouseEnter"
        MouseLeave="Overlay_MouseLeave">
    <Border x:Name="ActionPanel"
            Width="520" Height="176"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            Opacity="0"
            Background="Transparent"
            BorderThickness="0">
      <StackPanel Orientation="Horizontal"
                  Margin="8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Button Style="{StaticResource OverlayButtonStyle}"
                ToolTip="{DynamicResource RotateNow}"
                Click="RotateNow_Click">
          <Viewbox Width="64" Height="64">
            <Canvas Width="24" Height="24">
              <Path Data="M12,4 A8,8 0 1 1 4,12"
                    Stroke="White" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M4,7 L4,12 L9,12"
                    Stroke="White" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"/>
            </Canvas>
          </Viewbox>
        </Button>
        <Button Style="{StaticResource OverlayButtonStyle}"
                ToolTip="{DynamicResource OpenImageLocation}"
                Click="OpenLocation_Click">
          <Viewbox Width="64" Height="64">
            <Canvas Width="24" Height="24">
              <Rectangle Canvas.Left="3" Canvas.Top="4"
                         Width="18" Height="16"
                         RadiusX="2" RadiusY="2"
                         Fill="Transparent"
                         Stroke="White" StrokeThickness="1.7"/>
              <Ellipse Canvas.Left="7" Canvas.Top="7"
                       Width="3" Height="3"
                       Fill="White"/>
              <Path Data="M5,17 L10,12 L13,15 L16,12 L20,17"
                    Stroke="White" StrokeThickness="1.7"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"/>
            </Canvas>
          </Viewbox>
        </Button>
        <Button Style="{StaticResource OverlayButtonStyle}"
                ToolTip="{DynamicResource RemoveCurrentImage}"
                Margin="0"
                Click="RemoveCurrentImage_Click">
          <Viewbox Width="64" Height="64">
            <Canvas Width="24" Height="24">
              <Path Data="M5,7 L19,7 M9,7 L9,5 L15,5 L15,7 M7,7 L8,20 L16,20 L17,7 M10,10 L10.5,17 M14,10 L13.5,17"
                    Stroke="White" StrokeThickness="1.8"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"/>
            </Canvas>
          </Viewbox>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</Window>
