<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\mirafolio-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MiraFolio</AssemblyName>
    <Title>MiraFolio</Title>
    <Product>MiraFolio</Product>
    <Company>MiraFolio contributors</Company>
    <Description>面向 Windows 多显示器的智能壁纸轮替工具</Description>
    <Version>1.0.0</Version>
    <RootNamespace>MiraFolio.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiraFolio.Core\MiraFolio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\mirafolio-icon.ico" />
    <Resource Include="Resources\app-icon.png" />
  </ItemGroup>

</Project>
